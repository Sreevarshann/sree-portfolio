# Ask Sree — server-side only. Never prefix these with NEXT_PUBLIC_.
# Without a key for the selected provider the assistant explains it can't
# answer right now and links the relevant portfolio pages.
# Provider: groq | anthropic
ASK_SREE_PROVIDER=groq
GROQ_API_KEY=
# ANTHROPIC_API_KEY=                      # only when ASK_SREE_PROVIDER=anthropic

# Optional overrides (defaults shown)
# ASK_SREE_MODEL=openai/gpt-oss-120b     # Groq default; claude-opus-5-5 for Anthropic
# ASK_SREE_MAX_TOKENS=1200
# ASK_SREE_TIMEOUT_MS=45000
# ASK_SREE_RATE_PER_MINUTE=8              # per visitor (hashed IP), per instance
# ASK_SREE_RATE_PER_DAY=60
# ASK_SREE_DAILY_BUDGET=400               # total model calls per instance per day
# ASK_SREE_FALLBACKS=on                   # server-side refusal fallbacks (Opus/Sonnet)
# ASK_SREE_API_BASE_URL=https://api.groq.com/openai/v1

# Public site URL used for metadata, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://sree-portfolio.vercel.app
